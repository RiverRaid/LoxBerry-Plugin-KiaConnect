#!/bin/bash

# cron/cron.05min - wird von LoxBerry alle 5 Minuten aufgerufen.
# Installiert nach $LBHOMEDIR/system/cron/cron.05min/kia2lox. Laeuft als
# Benutzer "loxberry".
#
# Die 5-Minuten-Taktung ist nur der "Puls": ob ein Fahrzeug bei einem
# Durchlauf wirklich abgefragt wird, entscheidet kia2lox_poll.py selbst
# anhand des pro Fahrzeug eingestellten Intervalls/Zeitfensters
# (should_poll_now() in bin/kia2lox_poll.py).

set -a
source /etc/environment
set +a

PLUGIN_FOLDER="kia2lox"
VENVPY="$LBPDATA/$PLUGIN_FOLDER/venv/bin/python3"
SCRIPT="$LBPBIN/$PLUGIN_FOLDER/kia2lox_poll.py"
LOGDIR="$LBPLOG/$PLUGIN_FOLDER"
LOGFILE="$LOGDIR/poll.log"

mkdir -p "$LOGDIR"

if [ -x "$VENVPY" ]; then
	"$VENVPY" "$SCRIPT" >> "$LOGFILE" 2>&1
else
	echo "$(date '+%F %T') FEHLER: Python-venv nicht gefunden: $VENVPY" >> "$LOGFILE"
fi
